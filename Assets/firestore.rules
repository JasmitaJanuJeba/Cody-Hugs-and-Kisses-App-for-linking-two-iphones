// Firestore Security Rules for Hugs & Kisses
// Deploy: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read:  if request.auth != null;            // partner needs to read FCM token
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Invite codes: anyone authenticated can create; anyone can read (to join)
    // Only the inviter or accepter may update it
    match /invites/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;           // accepter writes their info
      allow delete: if false;
    }

    // Messages: sender can create; recipient can read/update (to mark consumed)
    match /messages/{msgId} {
      allow create: if request.auth != null
                    && request.resource.data.senderUID == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.recipientUID == request.auth.uid;
    }
  }
}
